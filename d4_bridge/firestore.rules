rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net: deny anything not explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitives & Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function changedKeys() { return incoming().diff(existing()).affectedKeys(); }

    // -------------------------------------------------------------------
    // Platform admin role.
    //
    // Driven by a Firebase Auth custom claim — `admin: true` set via the
    // Firebase Admin SDK on the server. The README documents the
    // one-liner. This is intentionally a custom claim rather than a
    // Firestore-stored role so:
    //   * It's available in `request.auth.token` without an extra get(),
    //     so admin checks add no read cost.
    //   * It's signed by Firebase and unforgeable from the client.
    //   * It can't be self-promoted via a Firestore write — only the
    //     Admin SDK (which requires the service account key) can flip it.
    //
    // What admins can do (broadly): read everything, edit/delete events
    // and event sub-collections (slug, tierSales, promoUses, checkIns)
    // for support purposes, override organizer-only writes.
    //
    // What admins CANNOT do (deliberately):
    //   * Mint tickets directly. The ticket-create rule still requires a
    //     stripeSessionId — we don't want admins (or compromised admin
    //     accounts) bypassing the payment flow.
    //   * Claim transfers on behalf of a receiver. That's a personal
    //     act tied to the receiver's auth token email.
    //   * Mutate the audit log. checkIns stays append-only for
    //     everyone, including admins.
    //
    // Audit logging of admin writes themselves is a backlog item —
    // ideally every admin-side mutation should land in an immutable
    // adminActions/ collection. Out of scope for this rule pass.
    // -------------------------------------------------------------------
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // -------------------------------------------------------------------
    // Multi-tenant orgs RBAC (Bridge Phase 1 — Sprint 1).
    //
    // Every venue/promoter is an Organization. Memberships live at
    // `org_memberships/{orgId}_{uid}` with a composite id so this check
    // is a single exists()+get() rather than a query. Roles:
    //
    //   owner    — full control. Edit org settings, billing, members,
    //              and any event the org owns.
    //   manager  — day-to-day operator. Edit events, run check-in,
    //              view reports. Cannot change org settings or members.
    //   finance  — read-only events + financials, can issue refunds
    //              when wired up. Cannot edit events or check anyone in.
    //   scanner  — door staff. Read events + scan check-ins. No edits.
    //   content  — edit event content (description, images, tier copy).
    //              Cannot publish, refund, or check anyone in.
    //
    // `hasOrgRole(orgId, [...])` is the canonical check used by every
    // event/tier/promo/checkin rule that needs "is the caller staff
    // of the org that owns this event?". Admin (Firebase Auth custom
    // claim) bypasses every check.
    //
    // Disabled memberships (membership doc with `disabled == true`) are
    // ignored, keeping the doc for audit while revoking access.
    // -------------------------------------------------------------------
    function membershipDoc(orgId, uid) {
      return get(/databases/$(database)/documents/org_memberships/$(orgId + '_' + uid));
    }
    function membershipExists(orgId, uid) {
      return exists(/databases/$(database)/documents/org_memberships/$(orgId + '_' + uid));
    }
    function hasOrgRole(orgId, allowedRoles) {
      return isAdmin() || (
        isVerified() &&
        membershipExists(orgId, request.auth.uid) &&
        membershipDoc(orgId, request.auth.uid).data.role in allowedRoles &&
        membershipDoc(orgId, request.auth.uid).data.disabled != true
      );
    }
    function isOrgOwner(orgId) {
      return hasOrgRole(orgId, ['owner']);
    }

    // Convenience: caller is staff (owner|manager) of the parent event's
    // org, OR an admin. Used by every event sub-collection rule that
    // needs "organizer of this event" semantics.
    //
    // Reads the event's `orgId` field for the lookup. Falls back to the
    // legacy `organizerId == uid` check when `orgId` is absent so events
    // created before the Sprint 1 migration keep working until the
    // migration script backfills them.
    function isEventStaff(eventId) {
      return isAdmin() ||
        (isVerified() && (
          // New path: org-scoped RBAC. Defensively validate that
          // orgId is a string before passing to hasOrgRole — a
          // malformed event doc with `orgId: null` or a non-string
          // value would otherwise build a malformed membership lookup
          // path. We don't trust event data shape on the read side;
          // the create rule via isValidEvent() does, but defense in
          // depth costs us nothing here.
          ('orgId' in get(/databases/$(database)/documents/events/$(eventId)).data.keys() &&
           get(/databases/$(database)/documents/events/$(eventId)).data.orgId is string &&
           isValidId(get(/databases/$(database)/documents/events/$(eventId)).data.orgId) &&
           hasOrgRole(get(/databases/$(database)/documents/events/$(eventId)).data.orgId, ['owner', 'manager'])) ||
          // Legacy path: pre-migration events keyed on organizerId.
          isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.organizerId)
        ));
    }

    // Look up a document at an arbitrary path (used to verify cross-collection
    // invariants — e.g., a transfer must exist before we let a ticket change owner).
    function transferDoc(transferId) {
      return get(/databases/$(database)/documents/transfers/$(transferId));
    }
    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      // Email is no longer mirrored into the user doc — it stays on the auth
      // token. The doc holds the display-only profile (uid + optional
      // displayName / photoURL / createdAt / updatedAt), so it's safe to
      // expose to other signed-in users for "ticket bought by <name>" labels.
      return data.keys().hasAll(['uid'])
        && data.keys().size() <= 15
        && data.uid == request.auth.uid
        && (!('displayName' in data.keys()) ||
            (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data.keys()) ||
            (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'organizerId', 'price', 'totalTickets'])
        && data.keys().size() <= 41
        && data.title is string && data.title.size() <= 100
        && data.organizerId is string && isValidId(data.organizerId)
        // New: optional orgId pointer to the owning organization. When
        // present, must be a valid id string. The events.update rule
        // additionally enforces that orgId can't change without admin.
        && (!('orgId' in data.keys()) ||
            (data.orgId is string && isValidId(data.orgId)))
        && data.price is number && data.price >= 0
        && data.totalTickets is int && data.totalTickets >= 0
        && (!('ticketsSold' in data.keys()) ||
            (data.ticketsSold is int && data.ticketsSold >= 0 && data.ticketsSold <= data.totalTickets))
        // Lifecycle: status defaults to published for backwards compat.
        // Anything in this enum is fine; legacy events without the field
        // continue to behave as 'published'.
        && (!('status' in data.keys()) ||
            data.status in ['draft', 'published', 'cancelled'])
        // IANA timezone string. Bounded length, but we don't try to validate
        // against a fixed list — Intl.supportedValuesOf is huge and the
        // organizer interface guards it on the client.
        && (!('timezone' in data.keys()) ||
            (data.timezone is string && data.timezone.size() <= 64))
        // ISO 4217 currency code. Three-letter alpha. Defaults to USD on
        // read when absent; we don't enforce that here so legacy events
        // continue to work.
        && (!('currency' in data.keys()) ||
            (data.currency is string && data.currency.size() == 3 &&
             data.currency.matches('^[A-Z]{3}$')))
        // Performer list. Optional. Max 10 entries; per-string length
        // is enforced client-side because Firestore rules can't
        // iterate list elements affordably. The list-size cap is
        // what stops a malicious client from inflating an event doc.
        && (!('performers' in data.keys()) ||
            (data.performers is list && data.performers.size() <= 10));
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['eventId', 'ownerId', 'status', 'organizerId'])
        && data.keys().size() <= 30
        && data.eventId is string && isValidId(data.eventId)
        && data.ownerId is string && isValidId(data.ownerId)
        && data.organizerId is string && isValidId(data.organizerId)
        && data.status in ['active', 'transferred', 'used', 'voided']
        // Barcode payload is small. Block anyone trying to inject 1MB strings.
        && (!('barcodeValue' in data.keys()) ||
            (data.barcodeValue is string && data.barcodeValue.size() <= 512))
        && (!('barcodeSecret' in data.keys()) ||
            (data.barcodeSecret is string && data.barcodeSecret.size() <= 256))
        // Pending-transfer lock. When set, the ticket is mid-flight
        // to a receiver — every consumer treats it as unscannable.
        // Cleared on claim or cancel. Either absent, null, or a
        // valid id string.
        && (!('pendingTransferId' in data.keys()) ||
            data.pendingTransferId == null ||
            (data.pendingTransferId is string && isValidId(data.pendingTransferId)));
    }

    // Shape-only validation for a transfer doc.
    //
    // Used on BOTH create and update. It deliberately does NOT enforce
    // `senderId == request.auth.uid` — the receiver of the transfer is the
    // one who flips it to 'completed', and they're not the sender.
    // Sender identity is enforced separately in the create rule.
    //
    // The 20-key budget leaves room for the denormalised event/tier fields
    // we store on the transfer so the receiver can render the claim UI
    // without reading the ticket (which Firestore rules forbid them from
    // doing).
    function isValidTransferShape(data) {
      return data.keys().hasAll(['ticketId', 'senderId', 'receiverEmail', 'status'])
        && data.keys().size() <= 20
        && data.ticketId is string && isValidId(data.ticketId)
        && data.senderId is string && isValidId(data.senderId)
        && data.receiverEmail is string && data.receiverEmail.size() <= 255
        // Stored email must be lowercase. We compare it to
        // request.auth.token.email (already lowercased by Firebase) at
        // claim time — without this constraint a transfer addressed to
        // "Bob@Example.com" would be unclaimable forever.
        && data.receiverEmail == data.receiverEmail.lower()
        && data.status in ['pending', 'completed', 'cancelled']
        // Optional denormalised fields (kept type-checked + size-bounded).
        && (!('eventId' in data.keys()) ||
            (data.eventId is string && isValidId(data.eventId)))
        && (!('eventTitle' in data.keys()) ||
            (data.eventTitle is string && data.eventTitle.size() <= 200))
        && (!('eventImage' in data.keys()) ||
            (data.eventImage is string && data.eventImage.size() <= 2048))
        && (!('tierName' in data.keys()) ||
            (data.tierName is string && data.tierName.size() <= 100))
        && (!('organizerId' in data.keys()) ||
            (data.organizerId is string && isValidId(data.organizerId)))
        // Optional senderEmail denormalised onto the doc so the receiver
        // can send a "ticket claimed" notification back without needing
        // to read the sender's user doc (which they can't, by design).
        && (!('senderEmail' in data.keys()) ||
            (data.senderEmail is string && data.senderEmail.size() <= 320 &&
             data.senderEmail == data.senderEmail.lower()));
    }

    // --- Rules ---

    match /users/{userId} {
      // Profile docs are intentionally readable to signed-in users so the UI
      // can show "owned by <name>" labels. Tighten this if you decide users'
      // emails should not be enumerable.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      // Email is sourced from the auth token — never let clients change the
      // Firestore copy (would let users impersonate each other in UI labels).
      // Admins can also fix display fields when supporting an organizer
      // whose profile is broken or abusive.
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming())
        && changedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    // -------------------------------------------------------------------
    // Organizations (Bridge Phase 1).
    //
    // Each venue/promoter is an org. Reads are public so the eventual
    // white-label storefront, /o/{slug} resolver, and "owned by <org>"
    // labels can render without an auth check. Writes are gated on
    // membership role — only `owner` can mutate the org doc itself.
    //
    // Slug uniqueness is reserved through the existing /slugs/{slug}
    // collection; the org doc carries the slug as a denormalised field
    // for fast reads.
    // -------------------------------------------------------------------
    match /orgs/{orgId} {
      allow read: if true;
      allow list: if isAdmin();

      // Anyone signed in can create an org for themselves. The bootstrap
      // membership doc that grants them `owner` is created in the same
      // batch — see the org create flow in `lib/orgs.ts`. We can't enforce
      // batch atomicity at the rule level, so we accept that a freshly
      // created org may briefly exist without a membership; the UI
      // creates both in one writeBatch.
      allow create: if isVerified()
        && incoming().keys().hasAll(['name', 'slug', 'ownerUid', 'createdAt'])
        && incoming().keys().size() <= 12
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().slug is string && incoming().slug.size() <= 80
        && incoming().slug.matches('^[a-z0-9][a-z0-9-]{0,79}$')
        && incoming().ownerUid == request.auth.uid;

      // Only org owners (or admins) can mutate the org doc itself —
      // changing name, theme, payments connection, distribution config.
      // Slug renames go through the same atomic flow as event slugs:
      // batch update of `orgs/{id}.slug` + create of new `slugs/{newSlug}` +
      // delete of old `slugs/{oldSlug}`. Rules don't enforce that batch;
      // the client owns the integrity.
      allow update: if isVerified() && isOrgOwner(orgId)
        && incoming().ownerUid == existing().ownerUid
        // Don't let an owner change the org id itself by misusing update.
        && incoming().keys().size() <= 12;

      // Deleting an org is admin-only for now. The cascade of orphaned
      // events / tickets / memberships is more product policy than rule
      // — we'll add a soft-delete flag in a later sprint.
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Org memberships.
    //
    // Doc id is `${orgId}_${uid}` so the rule helpers above can do a
    // single exists()/get() rather than a query. Writes are gated on
    // owner-of-the-org so an attacker can't grant themselves a role.
    //
    // Bootstrapping: when an org is created, the same writeBatch creates
    // the founding `owner` membership for the creator. We allow that
    // first membership write under a relaxed condition (the membership
    // names the calling uid AS BOTH the subject and the addedBy actor)
    // because the standard `isOrgOwner(orgId)` check would fail —
    // there's no membership doc yet.
    // -------------------------------------------------------------------
    match /org_memberships/{membershipId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        // A user can read their own memberships (so the app can list
        // the orgs they belong to).
        resource.data.uid == request.auth.uid
      );
      // Org owners can list their members (composite query by orgId).
      allow list: if isAdmin() || (
        isSignedIn() &&
        request.query.limit <= 200
      );

      // Bootstrap path: caller is claiming the founding owner
      // membership for an org. Either the org doesn't exist yet
      // (created in the same writeBatch — exists() reads pre-batch
      // state, so this is true at rule-eval time) OR the org exists
      // and the caller is the named ownerUid (recovery path: their
      // own membership got deleted and they're re-bootstrapping).
      //
      // Once any membership for this (orgId, caller) pair exists, the
      // bootstrap branch is closed via membershipExists() and writes
      // route through the staff-add branch below.
      //
      // A hostile user trying to bootstrap themselves into someone
      // else's org fails on either:
      //   * The org exists and they aren't ownerUid → the existing-org
      //     sub-branch rejects.
      //   * The org doesn't exist but they don't own the orgId → the
      //     orgs.create rule already enforces that the creator's uid
      //     matches ownerUid, so they can't fabricate a foreign org
      //     in the first place.
      allow create: if isVerified() && (
        isAdmin() ||
        // Bootstrap branch.
        (incoming().uid == request.auth.uid &&
         incoming().role == 'owner' &&
         incoming().addedBy == request.auth.uid &&
         membershipId == incoming().orgId + '_' + request.auth.uid &&
         !membershipExists(incoming().orgId, request.auth.uid) &&
         (
           !exists(/databases/$(database)/documents/orgs/$(incoming().orgId)) ||
           get(/databases/$(database)/documents/orgs/$(incoming().orgId)).data.ownerUid == request.auth.uid
         )
        ) ||
        // Staff-add branch: an existing owner adds a non-owner. Owner
        // promotion is admin-SDK only to avoid ownership shuffle
        // accidents.
        (isOrgOwner(incoming().orgId) &&
         incoming().addedBy == request.auth.uid &&
         membershipId == incoming().orgId + '_' + incoming().uid &&
         (incoming().role != 'owner' || isAdmin())) ||
        // Invite-claim branch: invitee creates their own membership by
        // citing a pending invite token. The invite doc's email field
        // must match the caller's verified email, and the role on the
        // membership must match the role on the invite (so a malicious
        // invitee can't promote themselves above what was offered).
        // Owner role can't be granted via this path either.
        (incoming().uid == request.auth.uid &&
         membershipId == incoming().orgId + '_' + request.auth.uid &&
         incoming().role != 'owner' &&
         incoming().keys().hasAll(['claimedFromInvite']) &&
         incoming().claimedFromInvite is string &&
         exists(/databases/$(database)/documents/org_invites/$(incoming().claimedFromInvite)) &&
         get(/databases/$(database)/documents/org_invites/$(incoming().claimedFromInvite)).data.status == 'pending' &&
         get(/databases/$(database)/documents/org_invites/$(incoming().claimedFromInvite)).data.orgId == incoming().orgId &&
         get(/databases/$(database)/documents/org_invites/$(incoming().claimedFromInvite)).data.role == incoming().role &&
         get(/databases/$(database)/documents/org_invites/$(incoming().claimedFromInvite)).data.email == request.auth.token.email.lower() &&
         request.auth.token.email_verified == true)
      );

      // Owners (or admins) can modify a member's role or disable them.
      // A member cannot promote themselves; the addedBy field is locked
      // to the original adder.
      allow update: if isVerified() && (
        isAdmin() ||
        (isOrgOwner(existing().orgId) &&
         incoming().orgId == existing().orgId &&
         incoming().uid == existing().uid &&
         incoming().addedBy == existing().addedBy &&
         // Owners can demote themselves only via admin tooling.
         (existing().uid != request.auth.uid || incoming().role == existing().role))
      );

      allow delete: if isVerified() && (isAdmin() || isOrgOwner(existing().orgId));
    }

    // -------------------------------------------------------------------
    // Org invites — email-based invitation tokens.
    //
    // Doc id is a random token (created by lib/orgs createInvite()).
    // Owner writes the invite naming the invitee's email + role; the
    // invitee, once signed in with that verified email, can read the
    // invite (rule: their token email matches) and claim it via the
    // org_memberships.create invite-claim branch below.
    //
    // Why a token-based read rule instead of `where email == X` query:
    // if any signed-in user could query invites by their own email,
    // listing them, we'd leak the existence of an invite to a user
    // who hadn't been told the token (relevant for transactional flows
    // like "this email was invited but they don't know it yet"). The
    // rule below gates read on the caller's auth-token email matching
    // the invite's email field — so a user with the wrong email
    // can't even confirm an invite exists for that address.
    // -------------------------------------------------------------------
    match /org_invites/{token} {
      // Read: owner of the org sees their org's invites; the invitee
      // (matched by email_verified token) sees their own invite.
      allow read: if isAdmin() ||
        (isVerified() &&
         (
           isOrgOwner(resource.data.orgId) ||
           (request.auth.token.email_verified == true &&
            request.auth.token.email.lower() == resource.data.email)
         ));

      // List: must scope to a specific org via where('orgId', '==', X)
      // AND the caller must be an owner of that org. Without the
      // orgId filter the rule rejects, which closes the leak where
      // a hostile user could enumerate the entire collection. The
      // scoped check uses request.query.where to verify the orgId
      // filter is on the query, then hasOrgRole confirms the caller
      // is owner of that filtered org.
      allow list: if isAdmin() || (
        isVerified() &&
        request.query.limit <= 200 &&
        // Only org owners can list their own org's invites. The
        // OrgMembers view queries `where orgId == X`; the rule
        // engine evaluates `resource.data.orgId` against caller's
        // membership for each candidate doc.
        isOrgOwner(resource.data.orgId)
      );

      // Create: owner writes a fresh invite. Cannot grant the owner
      // role (consistent with the org_memberships staff-add rule —
      // owner promotion is admin-SDK only).
      allow create: if isVerified() && (
        isAdmin() ||
        (isOrgOwner(incoming().orgId) &&
         incoming().keys().hasAll(['orgId', 'email', 'role', 'createdBy', 'createdAt', 'expiresAt', 'status']) &&
         incoming().keys().size() <= 10 &&
         incoming().email is string &&
         incoming().email == incoming().email.lower() &&
         incoming().role in ['manager', 'finance', 'scanner', 'content'] &&
         incoming().createdBy == request.auth.uid &&
         incoming().status == 'pending' &&
         incoming().expiresAt is timestamp)
      );

      // Update: two valid paths.
      //   1. Owner cancels (status pending -> cancelled).
      //   2. Invitee claims (status pending -> completed, sets claimedBy/At).
      // Anything else is rejected — invites are otherwise immutable.
      allow update: if isVerified() && (
        // Owner cancel.
        (isOrgOwner(existing().orgId) &&
         existing().status == 'pending' &&
         incoming().status == 'cancelled' &&
         changedKeys().hasOnly(['status'])) ||
        // Invitee claim — request.auth must match the invited email
        // AND have email_verified, AND incoming claimedBy == auth uid.
        (existing().status == 'pending' &&
         request.auth.token.email_verified == true &&
         request.auth.token.email.lower() == existing().email &&
         incoming().status == 'completed' &&
         incoming().claimedBy == request.auth.uid &&
         changedKeys().hasOnly(['status', 'claimedBy', 'claimedAt']))
      );

      // Delete: owners only — for cleanup of stale completed invites.
      allow delete: if isVerified() && (isAdmin() || isOrgOwner(existing().orgId));
    }

    match /events/{eventId} {
      // Drafts are visible only to the organizer; published events are
      // public; cancelled events stay readable so existing ticket holders
      // can see their event still exists. Legacy events without a status
      // field are treated as published. Admins always read. Org staff
      // (any role) can read their own org's drafts.
      allow read: if (
        isAdmin() ||
        !('status' in resource.data) ||
        resource.data.status == 'published' ||
        resource.data.status == 'cancelled' ||
        (isSignedIn() && resource.data.organizerId == request.auth.uid) ||
        // New path: any staff role of the owning org can read drafts.
        (isSignedIn() && 'orgId' in resource.data.keys() &&
         hasOrgRole(resource.data.orgId, ['owner', 'manager', 'finance', 'scanner', 'content']))
      );

      // Create: requester must own the create (organizerId == uid). If
      // an orgId is provided, requester must be owner|manager|content of
      // that org. Allowing the create without orgId keeps the legacy
      // create flow working until every code path is migrated.
      allow create: if isVerified() && isValidEvent(incoming())
        && incoming().organizerId == request.auth.uid
        && (!('ticketsSold' in incoming().keys()) || incoming().ticketsSold == 0)
        && (!('orgId' in incoming().keys()) ||
            hasOrgRole(incoming().orgId, ['owner', 'manager', 'content']));

      allow update: if isVerified() && (
        // Org-staff edit path (Sprint 1+). Owners and managers can
        // edit any field; content role can edit but cannot publish or
        // change financial fields — that narrower scope is enforced
        // in the UI for now and can be moved into rules later if needed.
        ('orgId' in existing().keys() &&
         hasOrgRole(existing().orgId, ['owner', 'manager', 'content']) &&
         isValidEvent(incoming()) &&
         // orgId itself can't be moved by an org-staff edit — that's a
         // transfer-of-ownership operation reserved for admins.
         incoming().orgId == existing().orgId) ||

        // Legacy organizer-equivalent edit (pre-orgs events, or events
        // whose owning org's membership doc is briefly missing). Same
        // requirement as before — uid must match the original creator.
        (isOwner(existing().organizerId) && isValidEvent(incoming())) ||

        // Platform admin acting on the organizer's behalf for support.
        // Same shape requirement as the organizer branch — admins can't
        // skip validation just because they have the role.
        (isAdmin() && isValidEvent(incoming())) ||

        // Buyer-side: increment ticketsSold ONLY. Per-tier sold counts now
        // live in the events/{eid}/tierSales/{tierId} sub-collection where
        // each doc has its own narrow rule that prevents tampering with
        // price / capacity / other tiers' counters. Previously this branch
        // also allowed `ticketTiers` to be rewritten — that was the
        // vulnerability that let any buyer overwrite the organizer's
        // pricing while pretending to "buy" a ticket.
        (changedKeys().hasOnly(['ticketsSold']) &&
         incoming().ticketsSold is int &&
         incoming().ticketsSold >= existing().ticketsSold &&
         incoming().ticketsSold <= existing().totalTickets &&
         incoming().organizerId == existing().organizerId)
      );

      allow delete: if isAdmin() ||
        (isVerified() && (
          // Org-scoped delete: only the owner role can delete.
          ('orgId' in existing().keys() && hasOrgRole(existing().orgId, ['owner'])) ||
          // Legacy delete by original organizer.
          isOwner(existing().organizerId)
        ));

      // ----------------------------------------------------------------
      // Per-promo-code redemption counters.
      //
      // The `discountCodes` array on the parent event holds metadata
      // (code, type, value, etc.) that only the organizer can write.
      // The redemption *count* moves into this sub-collection so a
      // buyer's increment can be rule-enforced against the configured
      // limit and expiry without giving them write access to the array.
      //
      // Doc id is the uppercase code itself, so EventDetails can do a
      // direct get() instead of scanning a collection.
      // ----------------------------------------------------------------
      match /promoUses/{code} {
        allow read: if true;

        allow create: if isVerified()
          && isEventStaff(eventId)
          && incoming().keys().hasAll(['usedCount'])
          && incoming().keys().size() <= 6
          && incoming().usedCount is int
          && incoming().usedCount == 0
          && (!('usageLimit' in incoming().keys()) ||
              incoming().usageLimit == null ||
              (incoming().usageLimit is int && incoming().usageLimit >= 1 && incoming().usageLimit <= 1000000))
          && (!('expiresAt' in incoming().keys()) ||
              incoming().expiresAt == null ||
              incoming().expiresAt is timestamp);

        allow update: if isVerified() && (
          // Organizer adjusts limits or expiry. Cannot touch usedCount —
          // that's a buyer-only counter so it never goes backwards.
          (isEventStaff(eventId) &&
           changedKeys().hasOnly(['usageLimit', 'expiresAt', 'lastUpdated'])) ||

          // Verified buyer increments usedCount. Constraints:
          //   * Strictly monotonic increase, capped at +10 per call so a
          //     malicious caller can't rocket the counter into the limit.
          //   * Must respect usageLimit if one is set.
          //   * Must be before expiresAt if one is set.
          (changedKeys().hasOnly(['usedCount', 'lastUsed']) &&
           incoming().usedCount is int &&
           incoming().usedCount > existing().usedCount &&
           incoming().usedCount <= existing().usedCount + 10 &&
           (existing().usageLimit == null ||
            !('usageLimit' in existing().keys()) ||
            incoming().usedCount <= existing().usageLimit) &&
           (existing().expiresAt == null ||
            !('expiresAt' in existing().keys()) ||
            existing().expiresAt > request.time))
        );

        allow delete: if isVerified()
          && isEventStaff(eventId);
      }

      // ----------------------------------------------------------------
      // Check-in lists.
      //
      // Inspired by hi.events' multi-list model: an organizer can have
      // many lists per event ("Main Door", "VIP Entry", "Press") with
      // each list scoped to a subset of tier ids. Multiple staff can
      // share a list and check attendees in concurrently.
      //
      // For now lists are admin/organizer-managed only — staff scoping
      // (specific UIDs allowed to scan a particular list) is modelled
      // via the optional `staffUids` field but not yet enforced by the
      // checkIns create rule (deferred until staff invites are wired).
      // ----------------------------------------------------------------
      match /checkInLists/{listId} {
        allow read, list: if isVerified() && isEventStaff(eventId);

        allow create: if isVerified() && isEventStaff(eventId)
          && incoming().keys().hasAll(['name', 'allowedTierIds'])
          && incoming().keys().size() <= 8
          && incoming().name is string && incoming().name.size() <= 80
          && incoming().allowedTierIds is list
          && incoming().allowedTierIds.size() <= 50
          && (!('staffUids' in incoming().keys()) ||
              (incoming().staffUids is list && incoming().staffUids.size() <= 50));

        allow update: if isVerified() && isEventStaff(eventId)
          && changedKeys().hasOnly(['name', 'allowedTierIds', 'staffUids', 'updatedAt']);

        allow delete: if isVerified() && isEventStaff(eventId);
      }

      // ----------------------------------------------------------------
      // Per-ticket check-in audit log.
      //
      // Doc id is the ticketId (one row per ticket per check-in).
      // Captures: organizerId, scannedAt, source ('camera' | 'manual'),
      // and any verification metadata (HMAC valid, bucket diff).
      //
      // Reads/writes are organizer-only. The doc is deliberately separate
      // from the ticket itself so an attacker compromising one collection
      // can't tamper with the other.
      // ----------------------------------------------------------------
      match /checkIns/{ticketId} {
        allow read, list: if isVerified() &&
          isEventStaff(eventId);

        allow create: if isVerified() &&
          isEventStaff(eventId) &&
          incoming().keys().hasAll(['organizerId', 'scannedAt']) &&
          incoming().keys().size() <= 10 &&
          incoming().organizerId == request.auth.uid;

        // Audit log is append-only. No edits. No deletes (organizer can't
        // erase their own scan history, even by accident).
        allow update, delete: if false;
      }

      // ----------------------------------------------------------------
      // Per-event REJECTION audit log — append-only.
      //
      // Every scan that gets refused (wrong-event, voided, used,
      // in-transfer, invalid-barcode, not-found) writes one entry
      // here. Organizers can review attempted misdirected scans on
      // the event report — useful for door-staff debugging AND for
      // spotting patterns of abuse (broker buying tickets to event_A
      // and attempting to walk into event_B for a refund-then-resell
      // loop, repeated stale-screenshot scans, etc.).
      //
      // Append-only: organizers can't erase their own reject history.
      // Admins can read all but can't mutate.
      // ----------------------------------------------------------------
      match /scanRejects/{rejectId} {
        allow read, list: if isVerified() && isEventStaff(eventId);

        allow create: if isVerified() && isEventStaff(eventId)
          && incoming().keys().hasAll(['rejectedAt', 'organizerId', 'reason', 'source'])
          && incoming().keys().size() <= 12
          && incoming().organizerId == request.auth.uid
          && incoming().reason in [
            'wrong-event',
            'voided',
            'used',
            'in-transfer',
            'invalid-barcode',
            'not-found',
            'expired-code',
          ]
          && incoming().source in ['camera', 'manual']
          // Optional fields — when present, validated.
          && (!('ticketIdAttempted' in incoming().keys()) ||
              (incoming().ticketIdAttempted is string &&
               incoming().ticketIdAttempted.size() <= 128))
          && (!('wrongEventId' in incoming().keys()) ||
              (incoming().wrongEventId is string &&
               isValidId(incoming().wrongEventId)))
          && (!('wrongEventTitle' in incoming().keys()) ||
              (incoming().wrongEventTitle is string &&
               incoming().wrongEventTitle.size() <= 200))
          && (!('reasonDetail' in incoming().keys()) ||
              (incoming().reasonDetail is string &&
               incoming().reasonDetail.size() <= 200));

        allow update, delete: if false;
      }

      // Per-tier sold counters. One doc per tier id.
      // Reads are public (events are public). Writes:
      //   - Organizer of the parent event can create/delete the doc and
      //     set/raise capacity (e.g., when adding a tier or expanding it).
      //   - Anyone verified can increment `sold` within capacity. Decrement
      //     is forbidden so buyers can't "refund" each other.
      match /tierSales/{tierId} {
        allow read: if true;

        allow create: if isVerified()
          && isEventStaff(eventId)
          && incoming().keys().hasAll(['sold', 'capacity'])
          && incoming().keys().size() <= 7
          && incoming().sold is int && incoming().sold == 0
          && incoming().capacity is int && incoming().capacity >= 0
          && incoming().capacity <= 1000000
          // Optional sale-window timestamps. When set, the buyer-update
          // branch refuses increments outside [salesStart, salesEnd].
          // Either or both can be null/absent (= unbounded that side).
          && (!('salesStart' in incoming().keys()) ||
              incoming().salesStart == null ||
              incoming().salesStart is timestamp)
          && (!('salesEnd' in incoming().keys()) ||
              incoming().salesEnd == null ||
              incoming().salesEnd is timestamp);

        allow update: if isVerified() && (
          // Organizer can change capacity (only upward) and the sale
          // window. Cannot touch `sold` directly — that's purchase-driven.
          (isEventStaff(eventId) &&
           changedKeys().hasOnly(['capacity', 'salesStart', 'salesEnd', 'lastUpdated']) &&
           incoming().capacity is int &&
           incoming().capacity >= existing().sold &&
           incoming().capacity <= 1000000) ||

          // Verified buyer increments `sold` within capacity AND inside
          // the configured sale window. Strictly monotonic so two
          // simultaneous purchases can race the rule engine but neither
          // can decrement another's count.
          (changedKeys().hasOnly(['sold', 'lastUpdated']) &&
           incoming().sold is int &&
           incoming().sold >= existing().sold &&
           incoming().sold <= existing().capacity &&
           incoming().capacity == existing().capacity &&
           // Sale-window enforcement — only blocks when the field is set.
           // Legacy tierSales docs without salesStart/salesEnd continue
           // to behave as "always on sale", same as before.
           (!('salesStart' in existing().keys()) ||
            existing().salesStart == null ||
            existing().salesStart <= request.time) &&
           (!('salesEnd' in existing().keys()) ||
            existing().salesEnd == null ||
            existing().salesEnd > request.time))
        );

        allow delete: if isVerified()
          && isEventStaff(eventId);
      }
    }

    match /tickets/{ticketId} {
      // Identity isolation — only parties to the ticket may read it.
      // Admins can read for support purposes (refund disputes, etc.).
      allow get: if isAdmin() || (isSignedIn() && (
        existing().ownerId == request.auth.uid ||
        existing().buyerId == request.auth.uid ||
        existing().organizerId == request.auth.uid
      ));
      allow list: if isAdmin() || (isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      ));

      // TODO(security/payments): clients should not be able to mint tickets
      // directly — a Cloud Function triggered by the Stripe webhook should
      // own this. Until that lands, we require a stripeSessionId reference
      // on the document so it's at least loosely coupled to a payment intent
      // (the rule cannot verify the session itself).
      allow create: if isVerified() && isValidTicket(incoming())
        && incoming().buyerId == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'active'
        && 'stripeSessionId' in incoming().keys()
        && incoming().stripeSessionId is string
        && incoming().stripeSessionId.size() > 0
        && incoming().stripeSessionId.size() <= 256;

      allow update: if isVerified() && isValidTicket(incoming()) && (
        // 1) Current owner rotates their barcode (the rotating-secret refresh).
        (isOwner(existing().ownerId) &&
         changedKeys().hasOnly(['barcodeValue', 'barcodeSecret', 'lastReissueDate']) &&
         incoming().ownerId == existing().ownerId &&
         incoming().status == existing().status) ||

        // 2) Organizer check-in: marks the ticket used. Cannot reuse a ticket
        //    that's already been used — once used, status is sticky.
        //    Admins can do this same action for support purposes.
        ((isOwner(existing().organizerId) || isAdmin()) &&
         changedKeys().hasOnly(['status', 'checkInDate']) &&
         incoming().status == 'used' &&
         existing().status != 'used' &&
         incoming().ownerId == existing().ownerId &&
         incoming().organizerId == existing().organizerId) ||

        // 3) Transfer claim: the receiver of a *completed* transfer takes
        //    ownership. We require:
        //      - the request carries a transferId (echoed onto the ticket),
        //      - the referenced transfer document is for THIS ticket,
        //      - its status is 'completed',
        //      - its receiverEmail matches the caller's auth-token email,
        //      - the new ownerId is the caller,
        //      - the ticket has NOT already been used (so a claim cannot
        //        un-do an organizer check-in if both happen concurrently).
        //    This is what closes the "any user reassigns any ticket" hole.
        ('transferId' in incoming().keys() &&
         changedKeys().hasOnly(['ownerId', 'status', 'barcodeSecret', 'lastReissueDate', 'transferId']) &&
         incoming().status == 'active' &&
         existing().status != 'used' &&
         incoming().ownerId == request.auth.uid &&
         incoming().organizerId == existing().organizerId &&
         incoming().eventId == existing().eventId &&
         transferDoc(incoming().transferId).data.ticketId == ticketId &&
         transferDoc(incoming().transferId).data.status == 'completed' &&
         transferDoc(incoming().transferId).data.receiverEmail.lower() == request.auth.token.email.lower() &&
         (!('pendingTransferId' in incoming().keys()) || incoming().pendingTransferId == null)) ||

        // 5) Owner sets `pendingTransferId` when initiating a transfer.
        //    This is the field that locks the ticket: every consumer
        //    (wallet UI, door scan, barcode refresh) treats a non-null
        //    value as "in transit". We validate it points at a real
        //    transfer doc that was created BY this caller FOR this
        //    ticket and is still pending.
        (isOwner(existing().ownerId) &&
         changedKeys().hasOnly(['pendingTransferId', 'lastReissueDate']) &&
         incoming().pendingTransferId is string &&
         isValidId(incoming().pendingTransferId) &&
         incoming().ownerId == existing().ownerId &&
         incoming().status == existing().status &&
         transferDoc(incoming().pendingTransferId).data.ticketId == ticketId &&
         transferDoc(incoming().pendingTransferId).data.senderId == request.auth.uid &&
         transferDoc(incoming().pendingTransferId).data.status == 'pending') ||

        // 6) Owner clears `pendingTransferId` when the linked transfer
        //    has been cancelled. The rule requires the linked transfer
        //    to actually be cancelled so a sender can't grief by
        //    clearing the lock while the receiver is mid-claim.
        (isOwner(existing().ownerId) &&
         changedKeys().hasOnly(['pendingTransferId', 'lastReissueDate']) &&
         incoming().pendingTransferId == null &&
         existing().pendingTransferId is string &&
         transferDoc(existing().pendingTransferId).data.status == 'cancelled' &&
         incoming().ownerId == existing().ownerId &&
         incoming().status == existing().status) ||

        // 4) Organizer/admin voids (refunds) a ticket. Sticky once
        //    flipped — the ticket can never be reactivated. Used for
        //    fraud takedowns and manual refunds. Voided tickets are
        //    unscannable and the wallet UI mutes their QR.
        ((isOwner(existing().organizerId) || isAdmin()) &&
         changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidedReason']) &&
         incoming().status == 'voided' &&
         existing().status == 'active' &&
         incoming().ownerId == existing().ownerId &&
         incoming().organizerId == existing().organizerId &&
         incoming().voidedBy == request.auth.uid &&
         (!('voidedReason' in incoming().keys()) ||
          (incoming().voidedReason is string && incoming().voidedReason.size() <= 500)))
      );

      // Tickets are immutable history once created — no client-side delete.
      allow delete: if false;
    }

    match /transfers/{transferId} {
      allow get: if isSignedIn() && (
        existing().senderId == request.auth.uid ||
        existing().receiverEmail.lower() == request.auth.token.email.lower()
      );
      allow list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverEmail.lower() == request.auth.token.email.lower()
      );

      allow create: if isVerified()
        && isValidTransferShape(incoming())
        // Sender must be the writer (only checked at create — receivers
        // legitimately flip status during claim/decline).
        && incoming().senderId == request.auth.uid
        // The sender must currently own the ticket they're trying to transfer.
        && get(/databases/$(database)/documents/tickets/$(incoming().ticketId)).data.ownerId == request.auth.uid
        // Refuse a new transfer when the ticket already has a pending
        // lock. Closes the two-browser-tabs race where one ticket
        // could end up with two simultaneous pending transfers. The
        // owner has to cancel the existing transfer (which clears
        // pendingTransferId) before initiating a second one.
        && (!('pendingTransferId' in get(/databases/$(database)/documents/tickets/$(incoming().ticketId)).data.keys()) ||
            get(/databases/$(database)/documents/tickets/$(incoming().ticketId)).data.pendingTransferId == null)
        // Refuse transfers when the parent event is still a draft. The
        // receiver can't read a draft event, so the claim screen would
        // render with placeholder data and the transfer would be
        // effectively unclaimable until publish. Better to refuse up
        // front and ask the organizer to publish first.
        && (!('eventId' in incoming().keys()) ||
            !('status' in get(/databases/$(database)/documents/events/$(incoming().eventId)).data.keys()) ||
            get(/databases/$(database)/documents/events/$(incoming().eventId)).data.status != 'draft')
        // Brand-new transfers always start pending.
        && incoming().status == 'pending';

      allow update: if isVerified() && isValidTransferShape(incoming()) && (
        // Sender cancels a pending transfer.
        (isOwner(existing().senderId) &&
         existing().status == 'pending' &&
         incoming().status == 'cancelled' &&
         changedKeys().hasOnly(['status', 'updatedAt']) &&
         // Defence in depth: nobody — including the sender — should be
         // able to rewrite identity fields via an update.
         incoming().senderId == existing().senderId &&
         incoming().receiverEmail == existing().receiverEmail &&
         incoming().ticketId == existing().ticketId) ||

        // Receiver accepts (completes) or declines (cancels) a pending transfer.
        // Email comparison is lower-cased on both sides — the stored
        // receiverEmail is enforced lowercase by isValidTransferShape, but
        // we lower-case here too as belt-and-suspenders.
        (existing().receiverEmail.lower() == request.auth.token.email.lower() &&
         existing().status == 'pending' &&
         incoming().status in ['completed', 'cancelled'] &&
         changedKeys().hasOnly(['status', 'updatedAt']) &&
         incoming().senderId == existing().senderId &&
         incoming().receiverEmail == existing().receiverEmail &&
         incoming().ticketId == existing().ticketId)
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Slugs: a vanity-URL lookup table mapping slug -> eventId.
    //
    // First-write-wins uniqueness: rule allows `create` only, never
    // `update`. A second organizer trying to claim the same slug will
    // hit the allow-list-only update rule and the whole batch is
    // aborted, so they can pick a different one. The owning event's
    // organizer can delete the doc to free the slug back up (used when
    // EditEvent renames the slug).
    //
    // Public read so the SPA can resolve `/e/<slug>` → eventId without
    // auth.
    // ------------------------------------------------------------------
    match /slugs/{slug} {
      allow read: if true;

      // Two shapes share this collection:
      //   * Event slug — doc id = the slug itself, payload includes
      //     eventId. Used by /e/:slug routes.
      //   * Org slug — doc id = "org:" + slug, payload includes orgId
      //     and type:'org'. Used by /o/:slug routes (Sprint 2 white-label
      //     storefront). Prefix keeps the namespaces from colliding when
      //     an org name happens to match an event slug.
      allow create: if isVerified() && (
        // Event-slug branch — the slug must reference an event the
        // caller owns. We verify by reading the parent event.
        (incoming().keys().hasAll(['eventId', 'organizerId', 'createdAt']) &&
         incoming().keys().size() <= 5 &&
         incoming().eventId is string && isValidId(incoming().eventId) &&
         incoming().organizerId == request.auth.uid &&
         get(/databases/$(database)/documents/events/$(incoming().eventId)).data.organizerId == request.auth.uid &&
         slug.size() >= 3 && slug.size() <= 80 &&
         slug.matches('^[a-z0-9-]+$')) ||

        // Org-slug branch — the slug doc id is "org:" + the org's slug.
        // The payload names the org id; the corresponding org's
        // ownerUid must equal the caller (the createOrganization batch
        // writes both atomically, so this get() reads the to-be-committed
        // org from pre-batch state — but in a single batch the rule
        // evaluation is independent of write ordering. The orgs.create
        // rule already ensures only the would-be ownerUid creates the
        // org, so this branch is symmetric.)
        (slug.matches('^org:[a-z0-9][a-z0-9-]{0,79}$') &&
         incoming().keys().hasAll(['orgId', 'organizerId', 'type', 'createdAt']) &&
         incoming().keys().size() <= 6 &&
         incoming().type == 'org' &&
         incoming().orgId is string && isValidId(incoming().orgId) &&
         incoming().organizerId == request.auth.uid)
      );

      // Slugs are immutable by design — first write wins.
      allow update: if false;

      // Original organizer can free the slug back up (supports renaming).
      // Admins can also free a slug to help organizers recover from
      // typos or abandoned events.
      allow delete: if isAdmin() ||
        (isVerified() && existing().organizerId == request.auth.uid);
    }

    // ------------------------------------------------------------------
    // Mail queue for the Firebase Trigger Email extension.
    //
    // Schema (from extension docs):
    //   { to, message: { subject, html }, ... }
    //
    // We narrow the allowed shape so the queue can't be used as a
    // general spam relay. Each message must be tied to a specific
    // template name we explicitly whitelist; the receiver address must
    // match one of the parties on a transfer the caller is part of.
    //
    // Setup: install Firebase Extensions > "Trigger Email" and point it
    // at this collection. Without the extension, docs accumulate but
    // nothing is sent — that's fine for development.
    // ------------------------------------------------------------------
    match /mail/{mailId} {
      // Only the function/extension reads/processes these.
      allow read, update, delete: if false;

      allow create: if isVerified()
        && incoming().keys().hasAll(['to', 'message', 'templateName'])
        && incoming().keys().size() <= 10
        // Template gate — anything else is rejected. Add new templates
        // here as deliberately as you'd add a new email.
        && incoming().templateName in [
          'transfer-initiated',
          'transfer-claimed',
          'org-invite',
          'event-cancelled',
          'event-updated',
        ]
        && incoming().to is string
        && incoming().to.size() <= 320
        && incoming().to == incoming().to.lower()
        && incoming().message is map
        && incoming().message.subject is string
        && incoming().message.subject.size() <= 200
        && incoming().message.html is string
        && incoming().message.html.size() <= 20000;
    }

    // ----------------------------------------------------------------------
    // KNOWN GAPS — these need server-side enforcement to fully close.
    //   * Free-ticket minting: the create rule above requires a
    //     stripeSessionId field but cannot verify the Stripe session itself.
    //     Move ticket creation behind a Cloud Function that calls
    //     stripe.checkout.sessions.retrieve before writing.
    //   * Overselling under concurrency: the events.update rule clamps to
    //     totalTickets but two simultaneous purchases can both pass. Same
    //     fix — move the increment into a Firestore transaction in a Cloud
    //     Function and key fulfillment on session.id for idempotency.
    //   * Mail queue still trusts the client to pick the right `to`.
    //     A malicious user could enqueue templated spam to arbitrary
    //     addresses. The proper fix is to move this collection behind a
    //     Cloud Function that derives `to` from the transfer/ticket doc
    //     server-side.
    // ----------------------------------------------------------------------
  }
}
