rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default: deny everything not matched explicitly below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Event banner images, namespaced by uploader uid so users can't
    // overwrite each other's files. Reads are public because event detail
    // pages and the home feed surface the image to anonymous visitors.
    //
    // Constraints on writes:
    //   * Caller must be a verified, signed-in user.
    //   * The uid in the path must equal the caller's uid (no spoofing).
    //   * File must be an image MIME type.
    //   * Size capped at 5 MB — well under most CDNs' default per-request
    //     budget while still allowing reasonable banner artwork.
    match /event-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Org logos for the white-label storefront. Same shape as
    // event-images but namespaced by orgId so multiple staff (with
    // owner role) can upload on the org's behalf. We can't reach into
    // Firestore from Storage rules to verify org-membership directly,
    // so the namespace key is the orgId and the calling uid still has
    // to be email-verified. The Firestore-side enforcement of "only
    // owners can patch the theme.logoUrl field" is what actually keeps
    // a non-owner from changing what the storefront renders — uploads
    // to an unused-but-valid path are harmless.
    match /org-logos/{orgId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
