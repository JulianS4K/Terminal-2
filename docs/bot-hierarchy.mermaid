%% bot-hierarchy.mermaid — Terminal-2 LANE MAP (there is no hierarchy)
%%
%% Reframed 2026-07-02. The command hierarchy this file used to draw
%% (A1→B1→C1, "data-collection lanes under C1", "D3 sub of D2", "supervisor",
%% "sole prod pusher") was DISSOLVED. The codes are **lane identifiers** — names
%% for regions of the ownership map (which surface), NOT actors, ranks, or a
%% chain of command. No lane reports to, sits under, or manages another.
%% Permission is per-ACTION via the three principals (Applier/Auditor/Builder),
%% never per-label — see PROJECT_BIBLE.md §2.1. Ownership → §2.3/§2.5/§2.6.
%%
%% Tier-2 consolidation 2026-07-02 (KANBAN C1-OPS-3): C1 folded into B1 (docs
%% governance IS Auditor work), D2 folded into D0 (both broker-facing). Six
%% lanes now: substrate A1·B1 + products D0·D1·D3·D4. (c1/d2 survive only as
%% historical branch/KANBAN/bot_chat-tier tokens.)
%%
%% Filename kept only for link stability (KANBAN + LANE_DISCIPLINE template
%% point here); the content is a flat map, not an org chart.
%% ====================================================================

graph LR
    subgraph SUBSTRATE["Platform substrate — the shared foundation every product sits on (2 areas)"]
        A1["A1 · data + framework<br/>DB · migrations · crons · ingest · AQ mapper · server.py/routers/core · DB security"]
        B1["B1 · build + guards + governance<br/>git/code security · CI + guards · tests · docs (bibles + registry) · bot_chat  —  [Auditor surface]"]
    end

    subgraph PRODUCTS["Products — each owns one surface + its Render service"]
        D0["D0 · terminal + orders dashboard<br/>static/terminal/* · /api/broker/* · d2_dashboard/*"]
        D1["D1 · store<br/>static/store/* · /api/store/*"]
        D3["D3 · broadway<br/>broadway_*"]
        D4["D4 · Exos/Bridge<br/>d4_bridge/* · exos_* schema"]
    end

    %% The only edges are DEPENDENCY (data/APIs flow up from the substrate),
    %% not authority. No lane commands another.
    PRODUCTS -. "consume substrate data + APIs" .-> SUBSTRATE

    classDef laneClass fill:#e7f5ff,stroke:#339af0,color:#000,stroke-width:2px
    class A1,B1,D0,D1,D3,D4 laneClass
