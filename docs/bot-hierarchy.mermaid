%% bot-hierarchy.mermaid — Terminal-2 bot command structure
%%
%% ====================================================================
%% 2026-05-12 RESTRUCTURE — operator directive (final)
%% ====================================================================
%%
%% Hierarchy under C1:
%%
%%   D1  = Consumer Retail (search + storefront + share-links + checkout/share flow)
%%         — merge of old "S2 Retail Search Evo" + "P1 Retail Ticket System"
%%   D2  = Order Clients (seatdata + evo + seatgeek + tickpick + vivid ORDERS ONLY;
%%         listings infra moved to A1 / canonical lane)
%%         ├── Undelivered FE  (D2 scope minus seatdata — was old "S3 Undelivered FE")
%%         └── D3 Broadway     (live primary data scraper — was old "D1 Broadway")
%%   D4  = Our ticketing infra (own version of dice-like ticketing with AR codes;
%%         framing reference only, not a dice.fm integration; future scope)
%%
%%   Terminal FE: read-only reference + prediction guide. Charts, predictive
%%                models, possibly Grok integration. NO writes anywhere.
%%                Was old "S1 Terminal Front End".
%%
%% Naming locked. Historical bot_chat / audit docs referencing old
%% S1/S2/S3/P1 IDs preserved as audit record — no retroactive rename.
%%
%% ====================================================================
%% IN-FLIGHT HANDOFF — A1 -> B1 · 2026-05-10 · "security chat" session
%% ====================================================================
%% (Historical record. PR #57 merged 2026-05-11; all 16 backlog entries
%%  closed across the merge wave 2026-05-11/12. Kept for audit trail.)
%% ====================================================================

graph TD
    subgraph CONTROL[Command & Control]
        A1[A1 Primary/Audit/Push Bot<br/>Admin · maintains main]
        B1[B1 Security Manager Bot<br/>Manager · middle-man review]
        C1[C1 Data + Chat Bot<br/>Supervisor]

        A1 --> B1
        B1 --> C1
    end

    subgraph SUPERVISED[C1 Supervised Lanes]
        D1[D1 Consumer Retail<br/>search + storefront + share-links + checkout]
        D2[D2 Order Clients<br/>seatdata + evo + seatgeek + tickpick + vivid<br/>orders only]
        UFE[Undelivered FE<br/>D2 scope minus seatdata]
        D3[D3 Broadway<br/>Live primary data scraper]
        D4[D4 Our Ticketing Infra<br/>AR codes + custom ticketing<br/>future scope]
    end

    subgraph READ[Read-only View]
        TFE[Terminal FE<br/>Reference + prediction guide<br/>Charts · predictive models · Grok<br/>NO writes]
    end

    C1 --> D1
    C1 --> D2
    D2 --> UFE
    D2 --> D3
    C1 --> D4

    C1 -.->|read access| TFE
    A1 -.->|read access| TFE

    D2 -.->|order data| UFE
    D3 -.->|broadway events| D2

    A1 ==>|2026-05-10 security backlog<br/>PR #57 merged 2026-05-11<br/>historical| B1
    C1 ==>|bot_chat coordination<br/>live since PR #64| B1

    classDef adminClass fill:#ff6b6b,stroke:#c92a2a,color:#fff,stroke-width:3px
    classDef managerClass fill:#4c6ef5,stroke:#364fc7,color:#fff,stroke-width:3px
    classDef supervisorClass fill:#51cf66,stroke:#2f9e44,color:#fff,stroke-width:3px
    classDef dataClass fill:#74c0fc,stroke:#339af0,color:#000,stroke-width:2px
    classDef futureClass fill:#fff3bf,stroke:#fab005,color:#000,stroke-width:2px,stroke-dasharray:3 3
    classDef readClass fill:#e9ecef,stroke:#868e96,color:#000,stroke-width:2px,stroke-dasharray:5 5

    class A1 adminClass
    class B1 managerClass
    class C1 supervisorClass
    class D1,D2,UFE,D3 dataClass
    class D4 futureClass
    class TFE readClass
