--- M. the crons
        jobname        |  schedule  |                                          command                                          
-----------------------+------------+-------------------------------------------------------------------------------------------
 axs_watch_fill_daily  | 20 3 * * * | BEGIN; SET LOCAL statement_timeout = '120s'; SELECT public.axs_watch_fill(true); COMMIT;
 axs_watch_pace_hourly | 7 * * * *  | BEGIN; SET LOCAL statement_timeout = '60s'; SELECT public.axs_watch_pace_apply(); COMMIT;
 axs_watch_tick_1m     | 15 seconds | BEGIN; SET LOCAL statement_timeout = '12s'; SELECT public.axs_watch_tick(); COMMIT;

